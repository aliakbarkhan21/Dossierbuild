# Copy this file to .env, or set the variables in your shell. Nothing here is
# required to run the app: without a key the import page still reads a resume
# file, it just cannot parse it into fields.

# Your Gemini API key, for resume import and AI tailoring.
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.8-flash, with older flash and lite models as
# fallbacks when that one is busy.
# GEMINI_MODEL=gemini-3.8-flash

# Optional. Where your profile, backups, portrait and preferences are kept.
# Defaults to ./data. The container image sets this to /data and mounts a
# volume there.
# DOSSIER_DATA_DIR=./data
