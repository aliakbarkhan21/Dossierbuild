{#
  The shared half of every template.

  One document serves both jobs. Preview mode paints a grey desk with a white
  sheet on it and scales that sheet to the width available; print mode drops
  the desk and lets ``@page`` own the paper. Same markup, same measurements,
  same fonts -- which is the only way a preview can honestly claim to show
  what will come out of the printer.
#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ r.name }} — Resume</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?{{ fonts.google }}&display=swap" rel="stylesheet">
<style>
@page {
  size: {{ page.css }};
  margin: {{ margin_mm }}mm;
}

:root {
  --accent: {{ accent }};
  --ink: #16161A;
  --body: #24242B;
  --muted: #5A5A66;
  --rule: #D7D7DE;
  --rule-soft: #E8E8EE;
  /* ``| safe`` matters here and nowhere else in this file. Autoescaping is
     on because profile text is user data, but a font stack lives inside
     <style>, where CSS never decodes HTML entities -- so an escaped quote
     would make the whole declaration invalid and drop the page back to the
     browser's default serif. These three values are our own constants. */
  --f-head: {{ fonts.heading | safe }};
  --f-body: {{ fonts.body | safe }};
  --f-mono: {{ mono | safe }};
  --fs: {{ base_pt }}pt;
  /* Section headings run two points above whatever the body is set to.
     Every template sizes its own headings as a multiple of --fs -- .76 in
     minimal's gutter, 1.05 in executive -- and those multiples are the
     template's character, worth keeping. So the bump is added, not
     substituted: each heading stays in its own proportion and every one of
     them gains the same two points. One place to change it, and nothing to
     keep in step across nine files. */
  --sec-bump: 2pt;
  --lh: {{ leading }};
  --gap: {{ section_gap }}pt;
}

* { box-sizing: border-box; }

html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }

body {
  margin: 0;
  font-family: var(--f-body);
  font-size: var(--fs);
  line-height: var(--lh);
  color: var(--body);
  /* Chromium hyphenates nothing by default; a resume column is narrow enough
     that a long URL or "Containerisation" would otherwise push a line out. */
  overflow-wrap: break-word;
  -webkit-font-smoothing: antialiased;
}

a { color: inherit; text-decoration: none; }

/* ---- The sheet ------------------------------------------------------- */

{% if preview %}
{% if not scroll %}
/* A thumbnail never scrolls: it is a fixed window onto the page, and a
   scrollbar on it only offers to move a picture. */
html, body { overflow: hidden; }
{% endif %}
body {
  background: {{ desk_bg }};
  padding: {{ desk_pad }}px 0 {{ desk_pad }}px;
}
/* Deliberately outside the scaled sheet: a fit readout that shrinks with the
   zoom would be unreadable exactly when the page is busiest. */
.fitbar {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12px;
  padding: 0 16px 9px;
  font: 500 12.5px/1.45 -apple-system, "Segoe UI", Roboto, Helvetica, sans-serif;
  color: #54545E;
}
.fitbar b { color: #26262C; font-weight: 600; }
.fitbar .over { color: #A8422F; }
/* ``align-items: flex-start`` is load-bearing: the script below gives the
   desk an explicit height to match the scaled sheet, and a stretching flex
   child would grow to fill it, be measured taller, and grow again. */
.desk {
  display: flex;
  justify-content: flex-start;
  align-items: flex-start;
  padding-left: 13px;
}
{% if fit == 'page' %}
/* A full-screen read is looking at a sheet of paper, not at a column beside
   an editor: it belongs in the middle of the window. */
.desk { justify-content: center; padding-left: 0; }
body { padding-top: 0; }
{% endif %}
.sheet {
  /* ``flex: none`` is the difference between a preview and a lie. As a
     shrinkable flex item the sheet quietly narrows to whatever width the
     pane happens to be, and every line then breaks somewhere the printer
     will not break it. */
  flex: none;
  width: {{ page.width_mm }}mm;
  min-height: {{ page.height_mm }}mm;
  padding: {{ margin_mm }}mm;
  background: #fff;
  box-shadow: 0 1px 2px rgba(16,16,24,.10), 0 12px 32px rgba(16,16,24,.14);
  transform-origin: top left;
  position: relative;
}
{% if fit == 'page' %}
/* Centring the flex item is not centring the sheet. Layout sees the sheet at
   full A4 width whatever the transform does, so scaling about ``top left``
   pins the visible page to the left edge of a 794px box that is itself
   centred -- which put the page a long way left of the middle. The origin has
   to move with the centring, and it has to be declared after the rule above:
   same specificity, so source order is the whole of the argument. */
.sheet { transform-origin: top center; }
{% endif %}
/* Where Chromium will actually cut the paper. Drawn from measurements taken
   after layout, not guessed at -- see the script at the end.

   A gap the colour of the desk, rather than a dashed line with "PAGE 2" on
   it: two sheets with a gap between them is what paper looks like, and it
   needs no label to be understood. The band covers the few pixels of the line
   the printer cuts through anyway, which is the honest place to lose them. */
.pagebreak {
  position: absolute;
  left: 0; right: 0;
  height: 14px;
  background: {{ desk_bg }};
  pointer-events: none;
  /* The shadows are what make it two sheets rather than a stripe: each edge
     casts onto the desk the way the outside of the sheet does. */
  box-shadow: inset 0 7px 6px -6px rgba(16,16,24,.20),
              inset 0 -7px 6px -6px rgba(16,16,24,.20);
}
{% else %}
.sheet { padding: 0; }
{% endif %}

/* ---- Header ---------------------------------------------------------- */

.hdr-name {
  font-family: var(--f-head);
  font-weight: 700;
  color: var(--ink);
  line-height: 1.06;
  margin: 0;
}
.hdr-headline {
  color: var(--muted);
  margin: 2pt 0 0;
}
.contact {
  margin: 0;
  padding: 0;
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 0 10pt;
  font-size: calc(var(--fs) * .92);
  color: var(--muted);
}
.contact li { display: inline-flex; align-items: baseline; min-width: 0; overflow-wrap: anywhere; }
/* A separator drawn by CSS rather than typed into the data: it never ends up
   stranded at the end of a wrapped line the way a typed " | " does. */
.contact li + li::before {
  content: "";
  display: inline-block;
  width: 2.5pt; height: 2.5pt;
  margin-right: 10pt;
  border-radius: 50%;
  background: currentColor;
  opacity: .55;
  transform: translateY(-1.5pt);
}
.contact a { color: var(--accent); }

/* ---- Sections -------------------------------------------------------- */

.sec { margin-top: var(--gap); }
.sec:first-of-type { margin-top: 0; }
.sec > h2 {
  font-family: var(--f-head);
  font-size: calc(var(--fs) * 1.02 + var(--sec-bump));
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--accent);
  margin: 0 0 5pt;
  /* A heading that lands as the last line of a page is a wasted heading. */
  break-after: avoid-page;
  page-break-after: avoid;
}

.summary { margin: 0; }

/* ---- Entries --------------------------------------------------------- */

.entry { margin-top: 8pt; }
.entry:first-of-type { margin-top: 0; }
/* Deliberately not ``break-inside: avoid`` on the whole entry: a four-bullet
   role that will not fit gets pushed whole to the next page and leaves a
   third of a page blank. Keeping the *head* with its first lines is what
   actually matters. */
.entry-head { break-inside: avoid; break-after: avoid-page; }
.entry-line {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 10pt;
}
.entry-title {
  font-family: var(--f-head);
  font-weight: 700;
  color: var(--ink);
  font-size: calc(var(--fs) * 1.04);
}
.entry-sub { color: var(--body); font-weight: 600; }
/* A flex child will not shrink below its own content's minimum width, and for
   an unbroken token that minimum is the whole token -- so `overflow-wrap` on
   `body` never gets the chance to break it and the text runs off the right
   edge of the paper. It is not a hypothetical: a 300-character role title
   printed with 104 characters in the PDF's text layer, the rest silently
   gone, and a long portfolio URL vanished entirely. `min-width: 0` lets the
   box shrink; `anywhere` lets a word break where there is no space to break
   at. Real sources of one: a pasted link, a German compound, an import that
   ran two fields together. */
.entry-title,
.entry-sub,
.entry-note,
.entry-link { min-width: 0; overflow-wrap: anywhere; }
.entry-meta {
  color: var(--muted);
  font-size: calc(var(--fs) * .9);
  white-space: nowrap;
  flex: none;
}
.entry-note {
  color: var(--muted);
  font-size: calc(var(--fs) * .9);
}
.entry-link { color: var(--accent); font-size: calc(var(--fs) * .9); }

ul.bul {
  margin: 3pt 0 0;
  padding-left: 12pt;
  list-style: none;
}
ul.bul li {
  position: relative;
  margin-top: 2.5pt;
  break-inside: avoid;
  orphans: 2;
  widows: 2;
}
ul.bul li::before {
  content: "";
  position: absolute;
  left: -9pt;
  top: calc(var(--fs) * var(--lh) / 2 - 1.1pt);
  width: 3pt; height: 3pt;
  border-radius: 50%;
  background: var(--accent);
  opacity: .75;
}

.tags {
  margin: 3pt 0 0;
  font-size: calc(var(--fs) * .88);
  color: var(--muted);
}
.tags b { color: var(--body); font-weight: 600; }

/* ---- Portrait --------------------------------------------------------- */
/*
   Sized by a --pw the template sets, so one set of rules serves a 24mm
   headshot in a corner and a 32mm one at the top of a side column.
*/

.portrait {
  width: var(--pw, 26mm);
  height: var(--pw, 26mm);
  object-fit: cover;
  flex: none;
  display: block;
}
/* Square, always. A round crop throws away the corners of a photograph the
   person chose, and it is the frame every one of these layouts was measured
   for -- the round one only ever fitted two of them. The radius is enough to
   soften the corner at 300dpi and not enough to read as a decision. */
.portrait { border-radius: 2pt; }
.portrait.mono {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--accent);
  color: #fff;
  font-family: var(--f-head);
  font-weight: 600;
  letter-spacing: .04em;
  font-size: calc(var(--pw, 26mm) * .36);
  line-height: 1;
}

/* ---- Skills and one-line entries ------------------------------------- */

.skill-row {
  display: grid;
  grid-template-columns: {{ skill_label_col }} 1fr;
  gap: 0 8pt;
  margin-top: 3pt;
  break-inside: avoid;
}
.skill-row:first-child { margin-top: 0; }
.skill-label { font-weight: 700; color: var(--ink); }
/* A contact block stacked one item per line, for a column too narrow to
   carry them in a row. ``anywhere`` rather than ``break-word``: a 44mm column
   cannot fit "linkedin.com/in/muhammad-ali-akbar-khan" any other way, and a
   line that overflows the column is worse than one broken mid-word. */
.stack { margin: 0; padding: 0; list-style: none; }
.stack li { margin-top: 3.5pt; overflow-wrap: anywhere; }
.stack li:first-child { margin-top: 0; }

/* A credential's name, linked. Underlined rather than accent-coloured: on
   paper the link is not clickable, so the name has to still read as a name. */
.cred { text-decoration: underline; text-decoration-color: var(--rule); text-underline-offset: 2px; }
.cred, .cred-name { font-weight: 600; color: var(--ink); }

.pagenum {
  position: absolute;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 8px;
  color: #767680;
  pointer-events: none;
}

.lines { margin: 0; padding: 0; list-style: none; }
.lines li { margin-top: 3pt; break-inside: avoid; }
.lines li:first-child { margin-top: 0; }

{% if preview %}
/* ------------------------------------------------------------------ *
 * Editing on the page itself.
 *
 * All of it lives behind `{% raw %}{% if preview %}{% endraw %}`, so the document Chromium
 * prints contains none of these rules and none of the script below. That is
 * the invariant the whole feature is judged against: the PDF must not change
 * by a pixel because the page became editable.
 *
 * Nothing here affects layout. The outline is drawn with `box-shadow`, which
 * does not take space; the rail is `position: fixed` and therefore out of
 * flow. Both matter, because the paginator measures this document to decide
 * where the page breaks fall, and a feature that nudged the text would move
 * the breaks and make the preview a lie.
 * ------------------------------------------------------------------ */
/* A line with nothing in it yet.
 *
 * Pressing "+" on the page has to leave something to type into, and there is
 * nothing to draw. Zero height rather than hidden, so that the paginator --
 * which measures this document to decide where the pages break -- counts it
 * as nothing at all. Turn editing on and it opens up; turn it off and the
 * page is again exactly what the printer produces, which is the claim the
 * whole preview rests on.
 */
.ghost { height: 0; min-height: 0; margin: 0 !important; overflow: hidden; }
.ghost::before { display: none !important; }
body.editing .ghost {
  height: auto;
  min-height: 1.15em;
  margin-top: 2.5pt !important;
  outline: 1px dashed rgba(60, 120, 220, .45);
  border-radius: 2px;
}
body.editing .ghost::before { display: block !important; }

body.editing [data-edit] {
  box-shadow: 0 0 0 1px rgba(60, 120, 220, .25);
  border-radius: 2px;
}
body.editing [data-edit]:hover { box-shadow: 0 0 0 1px rgba(60, 120, 220, .5); }
body.editing [data-edit]:focus {
  outline: none;
  box-shadow: 0 0 0 2px rgba(60, 120, 220, .85);
}
.rail {
  position: fixed;
  z-index: 40;
  display: none;
  gap: 2px;
  padding: 2px;
  background: #fff;
  border: 1px solid #d9dbe0;
  border-radius: 5px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, .14);
}
.rail.on { display: flex; }
.rail button {
  width: 20px; height: 20px;
  display: flex; align-items: center; justify-content: center;
  font: 600 12px/1 -apple-system, "Segoe UI", system-ui, sans-serif;
  color: #3d4350;
  background: transparent;
  border: 0; border-radius: 3px;
  cursor: pointer;
  padding: 0;
}
.rail button:hover { background: #eef1f6; color: #10131a; }
.rail button.warn:hover { background: #fdecec; color: #b3261e; }
.rail button[disabled] { opacity: .3; cursor: default; }
{% endif %}

{% block extra_css %}{% endblock %}

{# After the template's own block, so an equal-scoring rule falls this way.
   See the header of _layouts for why that matters. #}
{% include "_layouts.html.j2" %}
</style>
</head>
<body class="{{ 'preview' if preview else 'print' }} tpl-{{ template_key }} lay-{{ layout_key }}">
{% if preview %}
{#- The rail is one element reused by every block, moved to whatever the
    pointer is over. Forty of them, one per bullet, would be forty elements
    the paginator has to walk past. -#}
<div class="rail" id="rail" aria-hidden="true">
  <button type="button" data-op="up" title="Move up">&#8593;</button>
  <button type="button" data-op="down" title="Move down">&#8595;</button>
  <button type="button" data-op="add" title="Add a line below">+</button>
  <button type="button" data-op="delete" class="warn" title="Remove">&#10005;</button>
</div>
{% endif %}
{% if preview and fitbar %}
<div class="fitbar"><div id="fit-left"></div><div id="fit-right"></div></div>
{% endif %}
<div class="desk">
<div class="sheet" id="sheet">
{% block content %}{% endblock %}
</div>
</div>

{% if preview %}
<script>
// Two jobs, and they cost very different amounts, so they are two functions.
//
// `measure` is about the document: how many pages the content runs to, where
// the paper is cut, and what the fit bar says. It reads `scrollHeight`, which
// forces a full layout of an A4 page, and it rebuilds elements.
//
// `fit` is about the window: the scale that puts the sheet in the pane, and
// the desk's size at that scale. It reads one width.
//
// Splitting them is a performance fix, not tidiness. Nine of these documents
// are alive on the Resume screen -- the preview and eight template
// thumbnails -- and every one of them gets a `resize` for every frame of the
// sidebar sliding in or out. Running the whole of `measure` nine times a
// frame is what made a 200ms animation stutter. A resize cannot change the
// page count: the sheet is a fixed number of millimetres wide and its text
// does not reflow. So a resize runs `fit` alone.
(function () {
  var sheet = document.getElementById('sheet');
  var desk = document.querySelector('.desk');
  var left = document.getElementById('fit-left');
  var right = document.getElementById('fit-right');
  var PAGE_H = {{ page_height_px }};
  var PAD = {{ margin_px }};
  var PAD_MM = {{ margin_mm }};
  var LINE = {{ line_px }};
  var zoom = {{ zoom }};
  var breaks = {{ 'true' if breaks else 'false' }};
  var fit_mode = '{{ fit }}';
  var numbered = {{ 'true' if design.show_page_numbers else 'false' }};

  var pages = 1;          // what `measure` found, what `fit` scales
  var sheetW = 0;         // fixed in mm, so it is read once
  var lastDeskW = -1;
  var queued = 0;

  function fit() {
    lastDeskW = desk.clientWidth;
    if (!sheetW) { sheetW = sheet.offsetWidth; }

    var scale;
    if (zoom > 0) {
      scale = zoom;
    } else if (fit_mode === 'page') {
      // Fit a sheet to the window's height, not its width. Fitting the width
      // of a wide window scales an A4 page far past readable and cuts off
      // everything below the fold, which is the opposite of what a full-page
      // view is for. The height available is measured from where the desk
      // actually starts, so the fit bar above it is accounted for rather than
      // guessed at.
      //
      // Then a quarter more. A laptop window is about 630px tall between the
      // bar and the fold, against a page 1123px tall -- fitting the whole
      // sheet inside that sizes the page for the one dimension the reader can
      // scroll, and the type comes out smaller than it will be on paper. The
      // view scrolls, so the page may run past the fold; that overrun is what
      // buys back a legible size.
      var top = desk.getBoundingClientRect().top;
      var byHeight = (window.innerHeight - top - 24) / PAGE_H * 1.25;
      scale = Math.min((lastDeskW - 26) / sheetW, byHeight);
    } else {
      scale = Math.min((lastDeskW - 26) / sheetW, 1.5);
    }

    sheet.style.transform = 'scale(' + scale + ')';
    // Tell whoever embedded us what the scale came out as.
    //
    // Only this document knows it: the automatic fit is computed here, from
    // the pane's width and the sheet's, and the host has neither. Without
    // this the zoom slider outside had nothing to show for "Fit" and sat
    // wherever it was last dragged, reporting a number that was not the
    // scale on screen. `event.source` identifies us at the other end -- there
    // are nine of these documents alive on the Resume screen.
    if (window.parent && window.parent !== window) {
      try {
        window.parent.postMessage({ dossierFit: scale, dossierPages: pages }, '*');
      } catch (e) { /* a host that will not be spoken to is not our problem */ }
    }
    desk.style.height = (PAGE_H * pages * scale) + 'px';
    desk.style.overflow = 'hidden';
    // A scaled sheet is wider than the pane at anything over fit, and a
    // transform does not affect layout -- so without an explicit width the
    // desk stays pane-width, clips the overflow and offers no scrollbar. That
    // is why zooming in appeared to do nothing at all. Only set it when the
    // sheet really is wider, or the minimum would defeat the centring.
    var scaledWidth = sheetW * scale + 26;
    desk.style.minWidth = scaledWidth > lastDeskW ? scaledWidth + 'px' : '';
  }

  //: Blocks the print stylesheet refuses to break inside. A cut landing on one
  //: moves it whole, so the preview has to move it too.
  var ATOMS = 'ul.bul li, .entry-head, .skill-row, .lines li, .stack li';

  /** Offset within the sheet, unscaled -- `getBoundingClientRect` is not,
      and the preview is under a zoom transform. */
  function topWithin(el, root) {
    var y = 0;
    while (el && el !== root) { y += el.offsetTop; el = el.offsetParent; }
    return y;
  }

  //: The seam's height, and it has to match `.pagebreak`'s. The band is not
  //: an overlay drawn over the text -- it occupies real space in the flow,
  //: which is the only way nothing ends up behind it.
  var GAP = 14;

  /** Top of the seam after page `i` (1-based), in sheet coordinates. */
  function seamTop(i, usable) {
    return PAD + i * usable + (i - 1) * GAP;
  }

  /** Where page `i`'s content begins. `seamTop(0)` makes page one work too. */
  function pageTop(i, usable) {
    return seamTop(i - 1, usable) + GAP;
  }

  /** The last pixel of content, ignoring the min-height set for the paper. */
  function contentBottom() {
    return sheet.scrollHeight - PAD;
  }

  /**
   * Give every page break real space, and move what would sit in it.
   *
   * The band used to be painted over the flow on the reasoning that it
   * "covers the few pixels of the line the printer cuts through anyway". The
   * printer cuts through nothing -- `ul.bul li`, `.entry-head` and
   * `.skill-row` all carry `break-inside: avoid` -- so covering anything is
   * covering text that is really there. Pushing the straddling block to the
   * boundary was not enough either: the band is 14px tall and centred on the
   * cut, so it still painted over the first 7px of whatever started the next
   * page. Measured: band 1603-1624, block starting 1613.
   *
   * So the seam is a real gap now. Each page holds `usable` of content, then
   * `GAP` of nothing with the band in it, then the next page. A block that
   * would land in the gap, or cross it, is moved to the far side -- which is
   * what the printer does with it.
   */
  function settle(usable) {
    var pages = 1;
    for (var i = 1; i < 60; i++) {
      var seam = seamTop(i, usable);
      if (contentBottom() <= seam + 0.5) break;

      var atoms = sheet.querySelectorAll(ATOMS);
      for (var a = 0; a < atoms.length; a++) {
        var el = atoms[a];
        var top = topWithin(el, sheet);
        var bottom = top + el.offsetHeight;
        // Reaches the seam, and starts before the far side of it.
        if (bottom > seam + 0.5 && top < seam + GAP - 0.5) {
          // A block that already begins this page cannot be moved off it --
          // it is as high as it goes, and pushing it would not terminate.
          if (top <= pageTop(i, usable) + 0.5) break;
          var current = parseFloat(getComputedStyle(el).marginTop) || 0;
          el.style.marginTop = (current + (seam + GAP - top)) + 'px';
          el.setAttribute('data-pushed', '');
          break;
        }
      }
      pages = i + 1;
    }
    return pages;
  }

  function measure() {
    // A thumbnail wants the scale and nothing else.
    //
    // It is rendered with no fit bar and no break markers, into a fixed
    // 168px window onto the top of page one -- so the page count, the
    // stretched paper and the markers below are all invisible in it, and
    // working them out means forcing a full layout of an A4 page to read
    // `scrollHeight`. Eight of these mount together with the preview when the
    // Resume screen opens, and that pagination was the bulk of the 200ms the
    // main thread spent there, which the sidebar highlight was trying to
    // slide through. `left` is the fit bar; `numbered` is the only other
    // thing here that needs a page count.
    if (!breaks && !left && !numbered) { fit(); return; }

    Array.prototype.forEach.call(
      document.querySelectorAll('.pagebreak, .pagenum'), function (n) { n.remove(); }
    );
    // Pushes are an output of the last pass too, and one left in place would
    // be measured as content and pushed again on the next.
    Array.prototype.forEach.call(
      sheet.querySelectorAll('[data-pushed]'),
      function (n) { n.style.marginTop = ''; n.removeAttribute('data-pushed'); }
    );
    // All of these have to go before measuring: the markers, the page
    // numbers and the stretched paper are outputs of the last pass, and
    // measuring them would make every pass believe the document had grown.
    // The page numbers are the sharpest version of it -- one is positioned
    // near the foot of the last page, so leaving it in place adds a page
    // every pass, and a two-page document reads as four in a blink.
    sheet.style.minHeight = '';

    var content = sheet.scrollHeight - PAD * 2;
    var usable = PAGE_H - PAD * 2;
    pages = Math.max(1, Math.ceil(content / usable));

    // What the printer would do with the line the cut lands on.
    //
    // The band used to be drawn straight over the flow, on the reasoning that
    // it "covers the few pixels of the line the printer cuts through anyway".
    // The printer cuts through nothing: `ul.bul li`, `.entry-head` and
    // `.skill-row` all carry `break-inside: avoid`, so a block that will not
    // fit moves to the next page whole. Measured on a two-page document, the
    // band sat at 1470px across a bullet spanning 1466-1520 -- a bullet the
    // PDF printed intact at the top of page two. The preview was showing a
    // cut that does not happen, in an app whose claim is that the preview is
    // the printed document.
    //
    // So: move the same blocks the printer moves, then draw the cut in the
    // gap that leaves. Page count is recomputed after, because pushing
    // content down is exactly the thing that can add a page.
    // Preview only. In print, Chromium's own pagination does this -- pushing
    // as well would move the content twice and change the printed document,
    // which is the one thing that must not happen here. `breaks` is false for
    // the print, but `numbered` can be true, so `measure()` does run.
    // In print, Chromium's own pagination does this; pushing as well would
    // move the content twice and change the printed document, which is the
    // one thing that must not happen here. `breaks` is false for the print,
    // but `numbered` can be true, so `measure()` does run there.
    if (breaks) pages = settle(usable);

    // Paper is paper: a two-page resume whose second page holds four lines
    // still shows two full sheets, because that is what comes out of the
    // printer.
    //
    // Height in the preview's own model, which is not `PAGE_H * pages`. The
    // preview is one continuous column that pays the margin once at the top
    // and once at the bottom, with a band drawn over each seam -- so a page
    // of it is `usable` tall, not `PAGE_H`. `PAGE_H * pages` added `PAD * 2`
    // of blank paper for every page after the first: 240px of nothing under
    // a three-page CV.
    sheet.style.minHeight =
      (PAD * 2 + usable * pages + (breaks ? GAP * (pages - 1) : 0)) + 'px';

    // The page number the print will carry, drawn where the print puts it.
    //
    // `show_page_numbers` reached `render_pdf` and stopped there, so the
    // switch changed the exported file and nothing on screen: pressing it
    // looked like pressing a dead button. Same corner, same size, same grey
    // as pdf_worker's footer template, so what you see is what comes out.
    if (numbered) {
      for (var n = 0; n < pages; n++) {
        var tag = document.createElement('div');
        tag.className = 'pagenum';
        tag.textContent = (n + 1) + ' / ' + pages;
        // Just above the seam, in the same coordinates the bands use.
        //
        // This read `PAGE_H * (n + 1)`, a different model of where a page
        // ends from the one the bands use, and the two drift apart by `PAD`
        // per page: +25px on page one, +146px on page two, +267px on page
        // three. So "2 / 3" was drawn a seventh of a page *below* its own
        // seam -- which is to say, on page three.
        tag.style.top = (seamTop(n + 1, usable) - 17) + 'px';
        tag.style.right = PAD + 'px';
        sheet.appendChild(tag);
      }
    }

    if (breaks) {
      for (var i = 1; i < pages; i++) {
        var gap = document.createElement('div');
        gap.className = 'pagebreak';
        // At the cut, not centred on it: the seam is real space in the flow
        // now, so the band fills a gap rather than covering text.
        gap.style.top = seamTop(i, usable) + 'px';
        sheet.appendChild(gap);
      }
    }

    if (left && right) {
      left.innerHTML =
        '<b>' + pages + (pages === 1 ? ' page' : ' pages') + '</b> · {{ page.name }}'
        + ' · ' + Math.round(PAD_MM) + 'mm margins';
      // No spill warning. "Page 2 holds about 1 line" was a real
      // measurement, not debug output -- it fired when the document ran just
      // past a page boundary -- but it read as an error on a document that
      // was not wrong, and it is the one line on this bar nobody asked for.
      // The page count beside it already says the document is two pages.
      if (pages === 1) {
        var room = Math.max(0, Math.round((usable - content) / LINE));
        right.innerHTML = room > 1 ? ('Room for about ' + room + ' more lines') : 'Full page';
      } else {
        right.innerHTML = '';
      }
    }

    fit();
  }

  // One `fit` per frame at most, and none at all when the width did not
  // actually move -- a thumbnail in a fixed-width panel gets a resize event
  // for every frame of an animation happening somewhere else on the page.
  function onResize() {
    if (queued) { return; }
    queued = requestAnimationFrame(function () {
      queued = 0;
      if (desk.clientWidth !== lastDeskW) { fit(); }
    });
  }

  // The full-page view zooms without asking the server for another document.
  // Re-rendering per step of a slider puts a round trip between the handle and
  // the page, and the scale is already a one-line job here: `fit` is the same
  // function a resize runs, and it reads `zoom` for exactly this. 0 hands the
  // page back to the automatic fit.
  window.addEventListener('message', function (event) {
    var data = event.data;
    if (!data) { return; }

    var next = data.dossierZoom;
    if (typeof next === 'number' && next >= 0) {
      zoom = next;
      fit();
    }

    // Margins, live.
    //
    // The margin is baked into the document -- `@page`, the sheet's padding
    // and the PAD the pager measures with -- so changing it properly means
    // asking the server for another render, and at a slider's rate that is a
    // round trip between the handle and the page. The three of them can be
    // set here instead, and `measure` re-paginates from the new figures, so
    // the sheet reflows under the finger. The debounced re-render still
    // arrives behind it and is what the print is taken from; this is the
    // same document with the same numbers, reached sooner.
    if (typeof data.dossierEdit === 'boolean') { enableEditing(data.dossierEdit); }

    var mm = data.dossierMargin;
    if (typeof mm === 'number' && mm > 0 && mm < 60) {
      PAD_MM = mm;
      PAD = mm * 96 / 25.4;
      sheet.style.padding = mm + 'mm';
      measure();
    }
  });

  // A link in the preview must not navigate the preview.
  //
  // The frame is sandboxed into an opaque origin, so a plain click on the
  // GitHub link in someone's header took the frame itself to github.com -- a
  // navigation the sandbox then refused, leaving the pane blank with the
  // document gone. The link is real and worth following, so every one of them
  // is retargeted at a new tab.
  //
  // Retargeted here rather than posted up to the host and opened with
  // `window.open`: that was the first attempt and the popup blocker ate it,
  // because a message handler has no user activation behind it. A `_blank`
  // link clicked by a person does. The host's iframe carries `allow-popups
  // allow-popups-to-escape-sandbox` for the same reason -- without the second
  // the destination opens inside this sandbox and renders broken.
  //
  // Only in the preview: the printed document has no script in it at all, so
  // what Chromium prints is untouched. `href` is already limited to http,
  // https, mailto and tel by `normalise_url`.
  function retarget() {
    var links = document.querySelectorAll('a[href]');
    for (var i = 0; i < links.length; i++) {
      links[i].target = '_blank';
      links[i].rel = 'noopener noreferrer';
    }
  }
  retarget();
  document.addEventListener('click', function (event) {
    // A link added after load -- nothing does that today, but a click that
    // navigated the frame is the failure this is here to prevent.
    var link = event.target && event.target.closest && event.target.closest('a[href]');
    if (link && link.target !== '_blank') { link.target = '_blank'; }
  }, true);

  /* ------------------------------------------------------------------ *
   * Editing on the page itself.
   *
   * The frame is sandboxed into an opaque origin, so the app cannot reach in
   * here and this cannot reach out. Everything crosses as a message, which is
   * also what keeps the data model honest: nothing is edited here. What
   * happens here is that a person types, and this says so; the profile is
   * changed by the store on the other side, through the same `edit` call the
   * Profile screen uses, so an in-place edit lands in the undo stack, in
   * autosave and in the writing standard exactly like a typed one.
   * ------------------------------------------------------------------ */
  var rail = document.getElementById('rail');
  var railFor = null;      // the block the rail is currently attached to
  var editing = false;

  /** Only the three marks survive, and they come back balanced by construction. */
  function marksOf(node) {
    if (node.nodeType === 3) { return node.nodeValue || ''; }
    if (node.nodeType !== 1) { return ''; }
    if (node.tagName === 'BR') { return '\n'; }
    var inner = '';
    for (var i = 0; i < node.childNodes.length; i++) {
      inner += marksOf(node.childNodes[i]);
    }
    var tag = { B: 'b', STRONG: 'b', I: 'i', EM: 'i', U: 'u' }[node.tagName];
    if (tag) { return inner.replace(/^\s+|\s+$/g, '') ? '<' + tag + '>' + inner + '</' + tag + '>' : inner; }
    if (/^(DIV|P|LI|TR)$/.test(node.tagName) && inner) { return '\n' + inner; }
    return inner;
  }

  function valueOf(el) {
    var out = '';
    for (var i = 0; i < el.childNodes.length; i++) { out += marksOf(el.childNodes[i]); }
    return out.replace(/^\n+/, '').replace(/\s*\n+\s*/g, ' ');
  }

  function send(payload) {
    if (!window.parent || window.parent === window) { return; }
    try { window.parent.postMessage(payload, '*'); } catch (e) { /* not our problem */ }
  }

  var pending = 0;
  function changed(el) {
    clearTimeout(pending);
    pending = setTimeout(function () {
      send({ dossierChange: { path: el.getAttribute('data-edit'), value: valueOf(el) } });
    }, 350);
  }

  function placeRail(block) {
    railFor = block;
    if (!block) { rail.className = 'rail'; return; }
    var box = block.getBoundingClientRect();
    // Left of the block where there is room, otherwise tucked just inside it.
    var width = 92;
    var left = box.left - width - 6;
    if (left < 4) { left = box.left + 4; }
    rail.style.left = Math.round(left) + 'px';
    rail.style.top = Math.round(Math.max(4, box.top)) + 'px';
    rail.className = 'rail on';
    // "+" adds a line, which only means something where lines live.
    var isLine = block.tagName === 'LI';
    rail.querySelector('[data-op="add"]').style.display = isLine ? '' : 'none';
  }

  function enableEditing(on) {
    editing = on;
    document.body.className = document.body.className.replace(/ ?editing/, '') + (on ? ' editing' : '');
    var fields = document.querySelectorAll('[data-edit]');
    for (var i = 0; i < fields.length; i++) {
      if (on) { fields[i].setAttribute('contenteditable', 'true'); }
      else { fields[i].removeAttribute('contenteditable'); }
    }
    if (!on) { placeRail(null); }
  }

  document.addEventListener('mousemove', function (event) {
    if (!editing) { return; }
    var target = event.target;
    if (rail.contains(target)) { return; }
    var block = target && target.closest && target.closest('[data-move]');
    if (block !== railFor) { placeRail(block); }
  });

  document.addEventListener('scroll', function () { if (editing) { placeRail(null); } }, true);

  rail.addEventListener('mousedown', function (event) {
    // The rail must not take the selection off the field behind it.
    event.preventDefault();
  });
  rail.addEventListener('click', function (event) {
    var button = event.target.closest && event.target.closest('button');
    if (!button || !railFor) { return; }
    send({ dossierCommand: { op: button.getAttribute('data-op'), path: railFor.getAttribute('data-move') } });
    placeRail(null);
  });

  document.addEventListener('input', function (event) {
    var field = event.target.closest && event.target.closest('[data-edit]');
    if (editing && field) { changed(field); }
  });

  document.addEventListener('focusin', function (event) {
    var field = event.target.closest && event.target.closest('[data-edit]');
    // While a field here has the caret, the host must not swap the document
    // out from under it -- a re-render on every keystroke would take the
    // caret with it. This is what tells it to hold.
    if (editing && field) { send({ dossierEditing: true }); }
  });
  document.addEventListener('focusout', function (event) {
    var field = event.target.closest && event.target.closest('[data-edit]');
    if (editing && field) {
      clearTimeout(pending);
      send({ dossierChange: { path: field.getAttribute('data-edit'), value: valueOf(field) } });
      send({ dossierEditing: false });
    }
  });

  // Paste arrives plain, for the reason it does in the editor: text copied
  // out of Word brings its own fonts and colours, and a resume has one type
  // scale set on the Resume screen.
  document.addEventListener('paste', function (event) {
    var field = event.target.closest && event.target.closest('[data-edit]');
    if (!editing || !field) { return; }
    event.preventDefault();
    var text = (event.clipboardData || window.clipboardData).getData('text/plain');
    document.execCommand('insertText', false, text.replace(/\s+/g, ' '));
  });

  document.addEventListener('keydown', function (event) {
    var field = event.target.closest && event.target.closest('[data-edit]');
    if (!editing || !field) { return; }
    var mark = { b: 'bold', i: 'italic', u: 'underline' }[event.key.toLowerCase()];
    if ((event.metaKey || event.ctrlKey) && mark) {
      event.preventDefault();
      document.execCommand('styleWithCSS', false, 'false');
      document.execCommand(mark);
      changed(field);
      return;
    }
    // A resume line is a line. Enter would open a second paragraph inside a
    // block the printed stylesheet has no rule for.
    if (event.key === 'Enter') { event.preventDefault(); field.blur(); }
    if (event.key === 'Escape') { field.blur(); }
  });

  // The document is replaced on every change to the profile, and a fresh one
  // starts with editing off and no memory of having been told otherwise. The
  // host cannot reliably message it before its listener exists, so the new
  // document asks -- which removes the race rather than narrowing it.
  send({ dossierReady: true });

  if (document.fonts && document.fonts.ready) { document.fonts.ready.then(measure); }
  window.addEventListener('load', measure);
  window.addEventListener('resize', onResize);
  measure();
})();
</script>
{% endif %}
</body>
</html>
