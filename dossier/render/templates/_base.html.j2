{#
  The shared half of every template.

  One document serves both jobs. Preview mode paints a grey desk with a white
  sheet on it and scales that sheet to the width available; print mode drops
  the desk and lets ``@page`` own the paper. Same markup, same measurements,
  same fonts -- which is the only way a preview can honestly claim to show
  what will come out of the printer.
#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ r.name }} — Resume</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?{{ fonts.google }}&display=swap" rel="stylesheet">
<style>
@page {
  size: {{ page.css }};
  margin: {{ margin_mm }}mm;
}

:root {
  --accent: {{ accent }};
  --ink: #16161A;
  --body: #24242B;
  --muted: #5A5A66;
  --rule: #D7D7DE;
  --rule-soft: #E8E8EE;
  /* ``| safe`` matters here and nowhere else in this file. Autoescaping is
     on because profile text is user data, but a font stack lives inside
     <style>, where CSS never decodes HTML entities -- so an escaped quote
     would make the whole declaration invalid and drop the page back to the
     browser's default serif. These three values are our own constants. */
  --f-head: {{ fonts.heading | safe }};
  --f-body: {{ fonts.body | safe }};
  --f-mono: {{ mono | safe }};
  --fs: {{ base_pt }}pt;
  --lh: {{ leading }};
  --gap: {{ section_gap }}pt;
}

* { box-sizing: border-box; }

html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }

body {
  margin: 0;
  font-family: var(--f-body);
  font-size: var(--fs);
  line-height: var(--lh);
  color: var(--body);
  /* Chromium hyphenates nothing by default; a resume column is narrow enough
     that a long URL or "Containerisation" would otherwise push a line out. */
  overflow-wrap: break-word;
  -webkit-font-smoothing: antialiased;
}

a { color: inherit; text-decoration: none; }

/* ---- The sheet ------------------------------------------------------- */

{% if preview %}
{% if not scroll %}
/* A thumbnail never scrolls: it is a fixed window onto the page, and a
   scrollbar on it only offers to move a picture. */
html, body { overflow: hidden; }
{% endif %}
body {
  background: {{ desk_bg }};
  padding: {{ desk_pad }}px 0 {{ desk_pad }}px;
}
/* Deliberately outside the scaled sheet: a fit readout that shrinks with the
   zoom would be unreadable exactly when the page is busiest. */
.fitbar {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12px;
  padding: 0 16px 9px;
  font: 500 12.5px/1.45 -apple-system, "Segoe UI", Roboto, Helvetica, sans-serif;
  color: #54545E;
}
.fitbar b { color: #26262C; font-weight: 600; }
.fitbar .over { color: #A8422F; }
/* ``align-items: flex-start`` is load-bearing: the script below gives the
   desk an explicit height to match the scaled sheet, and a stretching flex
   child would grow to fill it, be measured taller, and grow again. */
.desk {
  display: flex;
  justify-content: flex-start;
  align-items: flex-start;
  padding-left: 13px;
}
{% if fit == 'page' %}
/* A full-screen read is looking at a sheet of paper, not at a column beside
   an editor: it belongs in the middle of the window. */
.desk { justify-content: center; padding-left: 0; }
body { padding-top: 0; }
{% endif %}
.sheet {
  /* ``flex: none`` is the difference between a preview and a lie. As a
     shrinkable flex item the sheet quietly narrows to whatever width the
     pane happens to be, and every line then breaks somewhere the printer
     will not break it. */
  flex: none;
  width: {{ page.width_mm }}mm;
  min-height: {{ page.height_mm }}mm;
  padding: {{ margin_mm }}mm;
  background: #fff;
  box-shadow: 0 1px 2px rgba(16,16,24,.10), 0 12px 32px rgba(16,16,24,.14);
  transform-origin: top left;
  position: relative;
}
{% if fit == 'page' %}
/* Centring the flex item is not centring the sheet. Layout sees the sheet at
   full A4 width whatever the transform does, so scaling about ``top left``
   pins the visible page to the left edge of a 794px box that is itself
   centred -- which put the page a long way left of the middle. The origin has
   to move with the centring, and it has to be declared after the rule above:
   same specificity, so source order is the whole of the argument. */
.sheet { transform-origin: top center; }
{% endif %}
/* Where Chromium will actually cut the paper. Drawn from measurements taken
   after layout, not guessed at -- see the script at the end.

   A gap the colour of the desk, rather than a dashed line with "PAGE 2" on
   it: two sheets with a gap between them is what paper looks like, and it
   needs no label to be understood. The band covers the few pixels of the line
   the printer cuts through anyway, which is the honest place to lose them. */
.pagebreak {
  position: absolute;
  left: 0; right: 0;
  height: 14px;
  background: {{ desk_bg }};
  pointer-events: none;
  /* The shadows are what make it two sheets rather than a stripe: each edge
     casts onto the desk the way the outside of the sheet does. */
  box-shadow: inset 0 7px 6px -6px rgba(16,16,24,.20),
              inset 0 -7px 6px -6px rgba(16,16,24,.20);
}
{% else %}
.sheet { padding: 0; }
{% endif %}

/* ---- Header ---------------------------------------------------------- */

.hdr-name {
  font-family: var(--f-head);
  font-weight: 700;
  color: var(--ink);
  line-height: 1.06;
  margin: 0;
}
.hdr-headline {
  color: var(--muted);
  margin: 2pt 0 0;
}
.contact {
  margin: 0;
  padding: 0;
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 0 10pt;
  font-size: calc(var(--fs) * .92);
  color: var(--muted);
}
.contact li { display: inline-flex; align-items: baseline; }
/* A separator drawn by CSS rather than typed into the data: it never ends up
   stranded at the end of a wrapped line the way a typed " | " does. */
.contact li + li::before {
  content: "";
  display: inline-block;
  width: 2.5pt; height: 2.5pt;
  margin-right: 10pt;
  border-radius: 50%;
  background: currentColor;
  opacity: .55;
  transform: translateY(-1.5pt);
}
.contact a { color: var(--accent); }

/* ---- Sections -------------------------------------------------------- */

.sec { margin-top: var(--gap); }
.sec:first-of-type { margin-top: 0; }
.sec > h2 {
  font-family: var(--f-head);
  font-size: calc(var(--fs) * 1.02);
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--accent);
  margin: 0 0 5pt;
  /* A heading that lands as the last line of a page is a wasted heading. */
  break-after: avoid-page;
  page-break-after: avoid;
}

.summary { margin: 0; }

/* ---- Entries --------------------------------------------------------- */

.entry { margin-top: 8pt; }
.entry:first-of-type { margin-top: 0; }
/* Deliberately not ``break-inside: avoid`` on the whole entry: a four-bullet
   role that will not fit gets pushed whole to the next page and leaves a
   third of a page blank. Keeping the *head* with its first lines is what
   actually matters. */
.entry-head { break-inside: avoid; break-after: avoid-page; }
.entry-line {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 10pt;
}
.entry-title {
  font-family: var(--f-head);
  font-weight: 700;
  color: var(--ink);
  font-size: calc(var(--fs) * 1.04);
}
.entry-sub { color: var(--body); font-weight: 600; }
.entry-meta {
  color: var(--muted);
  font-size: calc(var(--fs) * .9);
  white-space: nowrap;
  flex: none;
}
.entry-note {
  color: var(--muted);
  font-size: calc(var(--fs) * .9);
}
.entry-link { color: var(--accent); font-size: calc(var(--fs) * .9); }

ul.bul {
  margin: 3pt 0 0;
  padding-left: 12pt;
  list-style: none;
}
ul.bul li {
  position: relative;
  margin-top: 2.5pt;
  break-inside: avoid;
  orphans: 2;
  widows: 2;
}
ul.bul li::before {
  content: "";
  position: absolute;
  left: -9pt;
  top: calc(var(--fs) * var(--lh) / 2 - 1.1pt);
  width: 3pt; height: 3pt;
  border-radius: 50%;
  background: var(--accent);
  opacity: .75;
}

.tags {
  margin: 3pt 0 0;
  font-size: calc(var(--fs) * .88);
  color: var(--muted);
}
.tags b { color: var(--body); font-weight: 600; }

/* ---- Portrait --------------------------------------------------------- */
/*
   Sized by a --pw the template sets, so one set of rules serves a 24mm
   headshot in a corner and a 32mm one at the top of a side column.
*/

.portrait {
  width: var(--pw, 26mm);
  height: var(--pw, 26mm);
  object-fit: cover;
  flex: none;
  display: block;
}
.portrait.circle { border-radius: 50%; }
.portrait.square { border-radius: 2pt; }
.portrait.mono {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--accent);
  color: #fff;
  font-family: var(--f-head);
  font-weight: 600;
  letter-spacing: .04em;
  font-size: calc(var(--pw, 26mm) * .36);
  line-height: 1;
}

/* ---- Skills and one-line entries ------------------------------------- */

.skill-row {
  display: grid;
  grid-template-columns: {{ skill_label_col }} 1fr;
  gap: 0 8pt;
  margin-top: 3pt;
  break-inside: avoid;
}
.skill-row:first-child { margin-top: 0; }
.skill-label { font-weight: 700; color: var(--ink); }
/* A contact block stacked one item per line, for a column too narrow to
   carry them in a row. ``anywhere`` rather than ``break-word``: a 44mm column
   cannot fit "linkedin.com/in/muhammad-ali-akbar-khan" any other way, and a
   line that overflows the column is worse than one broken mid-word. */
.stack { margin: 0; padding: 0; list-style: none; }
.stack li { margin-top: 3.5pt; overflow-wrap: anywhere; }
.stack li:first-child { margin-top: 0; }

/* A credential's name, linked. Underlined rather than accent-coloured: on
   paper the link is not clickable, so the name has to still read as a name. */
.cred { text-decoration: underline; text-decoration-color: var(--rule); text-underline-offset: 2px; }
.cred, .cred-name { font-weight: 600; color: var(--ink); }

.lines { margin: 0; padding: 0; list-style: none; }
.lines li { margin-top: 3pt; break-inside: avoid; }
.lines li:first-child { margin-top: 0; }

{% block extra_css %}{% endblock %}

{# After the template's own block, so an equal-scoring rule falls this way.
   See the header of _layouts for why that matters. #}
{% include "_layouts.html.j2" %}
</style>
</head>
<body class="{{ 'preview' if preview else 'print' }} tpl-{{ template_key }} lay-{{ layout_key }}">
{% if preview and fitbar %}
<div class="fitbar"><div id="fit-left"></div><div id="fit-right"></div></div>
{% endif %}
<div class="desk">
<div class="sheet" id="sheet">
{% block content %}{% endblock %}
</div>
</div>

{% if preview %}
<script>
// Two jobs, and they cost very different amounts, so they are two functions.
//
// `measure` is about the document: how many pages the content runs to, where
// the paper is cut, and what the fit bar says. It reads `scrollHeight`, which
// forces a full layout of an A4 page, and it rebuilds elements.
//
// `fit` is about the window: the scale that puts the sheet in the pane, and
// the desk's size at that scale. It reads one width.
//
// Splitting them is a performance fix, not tidiness. Nine of these documents
// are alive on the Resume screen -- the preview and eight template
// thumbnails -- and every one of them gets a `resize` for every frame of the
// sidebar sliding in or out. Running the whole of `measure` nine times a
// frame is what made a 200ms animation stutter. A resize cannot change the
// page count: the sheet is a fixed number of millimetres wide and its text
// does not reflow. So a resize runs `fit` alone.
(function () {
  var sheet = document.getElementById('sheet');
  var desk = document.querySelector('.desk');
  var left = document.getElementById('fit-left');
  var right = document.getElementById('fit-right');
  var PAGE_H = {{ page_height_px }};
  var PAD = {{ margin_px }};
  var LINE = {{ line_px }};
  var zoom = {{ zoom }};
  var breaks = {{ 'true' if breaks else 'false' }};
  var fit_mode = '{{ fit }}';

  var pages = 1;          // what `measure` found, what `fit` scales
  var sheetW = 0;         // fixed in mm, so it is read once
  var lastDeskW = -1;
  var queued = 0;

  function fit() {
    lastDeskW = desk.clientWidth;
    if (!sheetW) { sheetW = sheet.offsetWidth; }

    var scale;
    if (zoom > 0) {
      scale = zoom;
    } else if (fit_mode === 'page') {
      // Fit a sheet to the window's height, not its width. Fitting the width
      // of a wide window scales an A4 page far past readable and cuts off
      // everything below the fold, which is the opposite of what a full-page
      // view is for. The height available is measured from where the desk
      // actually starts, so the fit bar above it is accounted for rather than
      // guessed at.
      //
      // Then a quarter more. A laptop window is about 630px tall between the
      // bar and the fold, against a page 1123px tall -- fitting the whole
      // sheet inside that sizes the page for the one dimension the reader can
      // scroll, and the type comes out smaller than it will be on paper. The
      // view scrolls, so the page may run past the fold; that overrun is what
      // buys back a legible size.
      var top = desk.getBoundingClientRect().top;
      var byHeight = (window.innerHeight - top - 24) / PAGE_H * 1.25;
      scale = Math.min((lastDeskW - 26) / sheetW, byHeight);
    } else {
      scale = Math.min((lastDeskW - 26) / sheetW, 1.5);
    }

    sheet.style.transform = 'scale(' + scale + ')';
    desk.style.height = (PAGE_H * pages * scale) + 'px';
    desk.style.overflow = 'hidden';
    // A scaled sheet is wider than the pane at anything over fit, and a
    // transform does not affect layout -- so without an explicit width the
    // desk stays pane-width, clips the overflow and offers no scrollbar. That
    // is why zooming in appeared to do nothing at all. Only set it when the
    // sheet really is wider, or the minimum would defeat the centring.
    var scaledWidth = sheetW * scale + 26;
    desk.style.minWidth = scaledWidth > lastDeskW ? scaledWidth + 'px' : '';
  }

  function measure() {
    Array.prototype.forEach.call(
      document.querySelectorAll('.pagebreak'), function (n) { n.remove(); }
    );
    // Both of these have to go before measuring: the markers and the stretched
    // paper are outputs of the last pass, and measuring them would make every
    // pass believe the document had grown.
    sheet.style.minHeight = '';

    var content = sheet.scrollHeight - PAD * 2;
    var usable = PAGE_H - PAD * 2;
    pages = Math.max(1, Math.ceil(content / usable));
    // Paper is paper: a two-page resume whose second page holds four lines
    // still shows two full sheets, because that is what comes out of the
    // printer.
    sheet.style.minHeight = (PAGE_H * pages) + 'px';

    if (breaks) {
      for (var i = 1; i < pages; i++) {
        var gap = document.createElement('div');
        gap.className = 'pagebreak';
        // Centred on the cut rather than starting at it, so the sheet above
        // ends where the paper ends.
        gap.style.top = (PAD + usable * i - 7) + 'px';
        sheet.appendChild(gap);
      }
    }

    if (left && right) {
      var spill = content - usable * (pages - 1);
      var lines = Math.max(1, Math.round(spill / LINE));
      left.innerHTML =
        '<b>' + pages + (pages === 1 ? ' page' : ' pages') + '</b> · {{ page.name }}'
        + ' · {{ margin_mm | round | int }}mm margins';
      if (pages > 1 && lines <= 8) {
        // The case worth calling out: a page that exists to hold four lines.
        right.innerHTML = '<span class="over">Page ' + pages + ' holds about '
          + lines + (lines === 1 ? ' line' : ' lines') + '</span>';
      } else if (pages === 1) {
        var room = Math.max(0, Math.round((usable - content) / LINE));
        right.innerHTML = room > 1 ? ('Room for about ' + room + ' more lines') : 'Full page';
      } else {
        right.innerHTML = '';
      }
    }

    fit();
  }

  // One `fit` per frame at most, and none at all when the width did not
  // actually move -- a thumbnail in a fixed-width panel gets a resize event
  // for every frame of an animation happening somewhere else on the page.
  function onResize() {
    if (queued) { return; }
    queued = requestAnimationFrame(function () {
      queued = 0;
      if (desk.clientWidth !== lastDeskW) { fit(); }
    });
  }

  if (document.fonts && document.fonts.ready) { document.fonts.ready.then(measure); }
  window.addEventListener('load', measure);
  window.addEventListener('resize', onResize);
  measure();
})();
</script>
{% endif %}
</body>
</html>
